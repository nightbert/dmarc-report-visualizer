# ── General ───────────────────────────────────────────────────────────────────

SCAN_INTERVAL_SECONDS=   # seconds between worker ingest runs (default: 30)
REPORT_RETENTION_MONTHS= # delete reports older than this many months (default: 0 = disabled)

# ── Paths (optional overrides) ────────────────────────────────────────────────

INBOX_DIR=         # default: /data/inbox
REPORTS_DIR=       # default: /data/reports
STATUS_FILE=       # default: /data/status.json
REPORT_INDEX_FILE= # default: <reports dir>/.report-index.sqlite
MAILBOX_STATE_FILE= # default: /data/mailbox-state.json

# ── Mailbox fetching ──────────────────────────────────────────────────────────
# Optionally fetch DMARC report emails from a mailbox into the inbox.

# Master switch for the whole feature. While off, no mailbox is polled, the
# "Fetch mailbox" button is hidden, and the fetch endpoint is inactive — even
# when the provider credentials below are set.
MAILBOX_FETCH_ENABLED=   # true to enable the feature (default: false)

MAILBOX_PROVIDER=        # auto | m365 | imap (default: auto — IMAP if configured, else Microsoft 365)

# ── IMAP ──────────────────────────────────────────────────────────────────────
# Host, username, and password must all be set to enable IMAP fetching.
IMAP_HOST=
IMAP_USERNAME=
IMAP_PASSWORD=

IMAP_PORT=               # default: 993 for ssl, otherwise 143
IMAP_ENCRYPTION=         # ssl | starttls | none (default: ssl)
IMAP_VALIDATE_CERT=      # false to accept self-signed/invalid TLS certificates (default: true)
IMAP_FOLDER=             # folder to fetch from (default: INBOX)
IMAP_DELETE_AFTER_FETCH= # true: delete (\Deleted + expunge), false: mark as read (default: false)
IMAP_FETCH_ALL=          # true: all messages, false: only unread (default: false)
IMAP_MAX_MESSAGES=       # max messages per run, newest first (default: 25)

MAILBOX_POLL_INTERVAL_SECONDS= # seconds between automatic polls, both providers; 0 = UI button only (default: 0)

# ── Microsoft 365 (Microsoft Graph) ───────────────────────────────────────────
# All four values below must be set to enable Microsoft 365 fetching.
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_MAILBOX=

M365_FOLDER=             # folder to fetch from, well-known name or display name (default: Inbox)
M365_DELETE_AFTER_FETCH= # true: move to Deleted Items, false: mark as read (default: false)
M365_MAX_MESSAGES=       # page size, 1–100 Graph limit; all pages are followed (default: 25)


